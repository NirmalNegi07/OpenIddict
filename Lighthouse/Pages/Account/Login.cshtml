@page
@model Lighthouse.Pages.Account.LoginModel
@{
    ViewData["Title"] = "Sign in";
    Layout = "_Layout";
}

<div class="auth-card">
    <h1>Sign in to Lighthouse</h1>
    <p class="subtitle">A client application has asked you to sign in before it can continue.</p>

    <div asp-validation-summary="All" class="validation-summary-errors"></div>

    <form method="post" asp-route-returnUrl="@Model.ReturnUrl">
        <div class="field">
            <label asp-for="Input.Email">Email</label>
            <input asp-for="Input.Email" autocomplete="username" autofocus />
            <span asp-validation-for="Input.Email" class="field-validation-error"></span>
        </div>

        <div class="field">
            <label asp-for="Input.Password">Password</label>
            <input asp-for="Input.Password" type="password" autocomplete="current-password" />
            <span asp-validation-for="Input.Password" class="field-validation-error"></span>
        </div>

        <button type="submit" class="btn">Sign in</button>
    </form>

    <p class="hint">
        Seeded test account: <code>test@lighthouse.local</code> / <code>Passw0rd!</code>
    </p>
</div>
