<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Lighthouse</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="site-header">
        <div class="shell header-inner">
            <a class="brand" asp-area="" asp-page="/Index">
                <span class="brand-mark" aria-hidden="true">
                    <svg viewBox="0 0 24 24" width="20" height="20" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M12 2L9 8h6l-3-6z" fill="currentColor"/>
                        <path d="M8 9h8l1.5 12a1 1 0 0 1-1 1.1H7.5a1 1 0 0 1-1-1.1L8 9z" fill="currentColor" opacity="0.35"/>
                        <path d="M6 21h12" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
                    </svg>
                </span>
                Lighthouse
            </a>
            <nav class="header-nav">
                <a asp-area="" asp-page="/Index">Home</a>
                <a asp-area="" asp-page="/Privacy">Privacy</a>
            </nav>
        </div>
    </header>

    <main class="shell page-main">
        @RenderBody()
    </main>

    <footer class="site-footer">
        <div class="shell">
            Lighthouse &middot; local identity provider experiment &middot; <a asp-area="" asp-page="/Privacy">Privacy</a>
        </div>
    </footer>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
