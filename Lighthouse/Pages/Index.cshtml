@page
@model IndexModel
@{
    ViewData["Title"] = "Home";
}

<div class="hero">
    <h1>Lighthouse</h1>
    <p>The central identity provider for this experiment. It doesn't do anything on its own &mdash;
       client applications like Product A redirect users here to sign in via OAuth2 / OpenID Connect.</p>
    <div class="pill-row">
        <span class="pill">Authorization Code + PKCE</span>
        <span class="pill">OpenIddict</span>
        <span class="pill">ASP.NET Core Identity</span>
        <span class="pill">MySQL</span>
    </div>
</div>
